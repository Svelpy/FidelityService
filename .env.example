# =================================
# Formato (compatible con Docker y Dokploy)
# =================================
# - Una variable por línea: NOMBRE=valor
# - Sin espacios alrededor del "="
# - Sin comillas: Docker las pasa como parte del valor
# - Sin comentarios al final de la línea: Docker los pasa como parte del valor
# - Los comentarios van siempre en su propia línea, empezando con "#"
#
# Uso local con Docker:
# docker run --rm -p 8000:8000 --env-file .env fidelity-api

# =================================
# Application
# =================================
APP_NAME=FarmaTupa_API
APP_VERSION=1.0.0
APP_DESCRIPTION=Api para FarmaTupa, una plataforma para la fidelizacion y canjeo de puntos
# Valores permitidos: development | test | staging | production
ENVIRONMENT=development

# =================================
# PostgreSQL (SQLAlchemy async + asyncpg)
# =================================
# Formato requerido:
# postgresql+asyncpg://USUARIO:PASSWORD@HOST:PUERTO/BASE_DE_DATOS
#
# El proyecto usa exactamente dos bases de datos:
# - DATABASE_URL: producción (ENVIRONMENT=production).
# - TEST_DATABASE_URL: development, test y staging.
# La selección depende de ENVIRONMENT, no de DEBUG.
# Si el password contiene caracteres reservados, deben codificarse para URL:
# @ = %40, # = %23, ? = %3F, / = %2F, : = %3A, % = %25
#
# No usar "?sslmode=require": asyncpg no acepta ese parámetro y la conexión falla.
# Para exigir TLS se puede añadir "?ssl=require" al final de la URL.
#
# Supabase - Session Pooler (puerto 5432, compatible con IPv4 y con Docker):
# Copiar host y project ref desde Supabase > Connect > Session pooler.
# No usar el Transaction Pooler (puerto 6543): rompe los prepared statements de asyncpg.
# DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD_CODIFICADO@aws-0-REGION.pooler.supabase.com:5432/postgres
#
# Supabase - conexión directa (requiere IPv6; no funciona dentro de Docker por defecto):
# DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD_CODIFICADO@db.PROJECT_REF.supabase.co:5432/postgres
#
# PostgreSQL en la máquina anfitriona y la API dentro de Docker:
# "localhost" dentro del contenedor es el propio contenedor; usar host.docker.internal.
# DATABASE_URL=postgresql+asyncpg://fidelity_user:fidelity_password@host.docker.internal:5432/fidelity_db
#
# PostgreSQL y API dentro de la misma red de Docker (o Dokploy).
# "database" debe coincidir con el nombre del servicio o host interno de PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://fidelity_user:fidelity_password@database:5432/fidelity_db
#
# PostgreSQL en Docker con la API ejecutándose sin Docker:
DATABASE_URL=postgresql+asyncpg://fidelity_user:fidelity_password@localhost:5432/fidelity_db
#
# Base no productiva compartida por development, test y staging:
TEST_DATABASE_URL=postgresql+asyncpg://fidelity_user:fidelity_password@localhost:5432/fidelity_db_test

# =================================
# JWT (Authentication)
# =================================
# Mínimo 32 bytes cada una y deben ser diferentes entre sí.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=tu_secret_key_aqui
CSRF_SECRET_KEY=tu_csrf_secret_key_aqui

# =================================
# Cloudinary (Video & Image Storage)
# =================================
CLOUDINARY_CLOUD_NAME=dxxyswcjv
CLOUDINARY_API_KEY=tu_cloudinary_api_key
CLOUDINARY_API_SECRET=tu_cloudinary_api_secret
CLOUDINARY_FOLDER_NAME=YARI

# =================================
# CORS
# =================================
# Lista separada por comas, sin espacios.
# DEV_ORIGINS se usa en development y test; PROD_ORIGINS en staging y production.
DEV_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
PROD_ORIGINS=https://svelpy.com,https://tupaclub-client.pages.dev

